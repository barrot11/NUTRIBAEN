rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} {
      // Allow read and write to the bookings collection so the reservation system can function.
      allow read, write: if true;
    }
    match /health_tests/{testId} {
      // Allow saving health assessment test leads and scores
      allow read, write: if true;
    }
  }
}
